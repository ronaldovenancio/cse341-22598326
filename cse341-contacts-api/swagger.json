{
  "swagger": "2.0",
  "info": {
    "title": "Contacts API",
    "description": "API for creating, retrieving, updating, and deleting contacts stored in MongoDB.",
    "version": "1.0.0"
  },
  "host": "localhost:8080",
  "basePath": "/",
  "tags": [
    {
      "name": "Contacts",
      "description": "Endpoints for managing contacts"
    }
  ],
  "schemes": [
    "http"
  ],
  "paths": {
    "/": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/contacts/": {
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "Get all contacts",
        "description": "Returns all contacts stored in MongoDB.",
        "responses": {
          "200": {
            "description": "Contacts retrieved successfully.",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Contact"
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "post": {
        "tags": [
          "Contacts"
        ],
        "summary": "Create a new contact",
        "description": "Creates a new contact. All contact fields are required.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Contact information. All fields are required.",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ContactInput"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Contact created successfully.",
            "schema": {
              "$ref": "#/definitions/CreateContactResponse"
            }
          },
          "400": {
            "description": "One or more required fields are missing."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/contacts/{id}": {
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "Get a contact by ID",
        "description": "Returns one contact using its MongoDB ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ID of the contact."
          }
        ],
        "responses": {
          "200": {
            "description": "Contact retrieved successfully.",
            "schema": {
              "$ref": "#/definitions/Contact"
            }
          },
          "400": {
            "description": "Invalid contact ID."
          },
          "404": {
            "description": "Contact not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "put": {
        "tags": [
          "Contacts"
        ],
        "summary": "Update a contact",
        "description": "Updates an existing contact using its MongoDB ID. The ID itself is not modified.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ID of the contact."
          },
          {
            "name": "body",
            "in": "body",
            "description": "Updated contact information. All fields are required.",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ContactInput"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Contact updated successfully."
          },
          "400": {
            "description": "Invalid contact ID or missing required fields."
          },
          "404": {
            "description": "Contact not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "delete": {
        "tags": [
          "Contacts"
        ],
        "summary": "Delete a contact",
        "description": "Deletes an existing contact using its MongoDB ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ID of the contact."
          }
        ],
        "responses": {
          "204": {
            "description": "Contact deleted successfully."
          },
          "400": {
            "description": "Invalid contact ID."
          },
          "404": {
            "description": "Contact not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "definitions": {
    "Contact": {
      "type": "object",
      "properties": {
        "_id": {
          "type": "string",
          "example": "64f1a2b3c4d5e6f789012345"
        },
        "firstName": {
          "type": "string",
          "example": "William"
        },
        "lastName": {
          "type": "string",
          "example": "Cabral"
        },
        "email": {
          "type": "string",
          "example": "william@example.com"
        },
        "favoriteColor": {
          "type": "string",
          "example": "Blue"
        },
        "birthday": {
          "type": "string",
          "example": "1995-05-15"
        }
      }
    },
    "ContactInput": {
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string",
          "example": "William"
        },
        "lastName": {
          "type": "string",
          "example": "Cabral"
        },
        "email": {
          "type": "string",
          "example": "william@example.com"
        },
        "favoriteColor": {
          "type": "string",
          "example": "Blue"
        },
        "birthday": {
          "type": "string",
          "example": "1995-05-15"
        }
      },
      "required": [
        "firstName",
        "lastName",
        "email",
        "favoriteColor",
        "birthday"
      ]
    },
    "CreateContactResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "64f1a2b3c4d5e6f789012345"
        }
      }
    }
  }
}