          "default": {
            "description": ""
          }
        }
      }
    },
    "/auth/github": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Login with GitHub",
        "description": "Starts the GitHub OAuth authorization flow.",
        "responses": {
          "302": {
            "description": "Redirects the user to GitHub."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/auth/github/callback": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "GitHub OAuth callback",
        "description": "Handles the GitHub OAuth callback and establishes the authenticated application session.",
        "responses": {
          "302": {
            "description": "Authentication succeeded and the user is redirected to the API documentation."
          },
          "401": {
            "description": "GitHub authentication failed."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/auth/status": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Check authentication status",
        "description": "Returns whether the current user has an authenticated session.",
        "responses": {
          "200": {
            "description": "Authentication status returned successfully."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/auth/profile": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Get authenticated user profile",
        "description": "Protected route. Returns the current authenticated user profile.",
        "responses": {
          "200": {
            "description": "Authenticated user profile returned successfully."
          },
          "401": {
            "description": "Authentication required."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/auth/failure": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "GitHub authentication failure",
        "description": "Returns an error when GitHub authentication is unsuccessful.",
        "responses": {
          "401": {
            "description": "GitHub authentication failed."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/auth/logout": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Log out",
        "description": "Protected route. Ends the authenticated user session.",
        "responses": {
          "200": {
