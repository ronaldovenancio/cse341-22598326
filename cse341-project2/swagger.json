          },
          "401": {
            "description": "Authentication required."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/movies/": {
      "get": {
        "tags": [
          "Movies"
        ],
        "summary": "Get all movies",
        "description": "Returns all movies stored in the database.",
        "responses": {
          "200": {
            "description": "Movies retrieved successfully.",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Movie"
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "post": {
        "tags": [
          "Movies"
        ],
        "summary": "Create a movie",
        "description": "Creates a new movie.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Movie information. All fields are required.",
            "required": true,
            "schema": {
              "$ref": "#/definitions/MovieInput"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Movie created successfully.",
            "schema": {
              "$ref": "#/definitions/CreateResponse"
            }
          },
          "400": {
            "description": "Validation failed."
          },
          "401": {
            "description": "Authentication required."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/movies/{id}": {
      "get": {
        "tags": [
          "Movies"
        ],
        "summary": "Get movie by ID",
        "description": "Returns one movie using its MongoDB ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ID of the movie."
          }
        ],
        "responses": {
          "200": {
            "description": "Movie retrieved successfully.",
            "schema": {
              "$ref": "#/definitions/Movie"
            }
          },
          "400": {
            "description": "Invalid movie ID."
          },
          "404": {
            "description": "Movie not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "put": {
        "tags": [
          "Movies"
        ],
        "summary": "Update a movie",
        "description": "Updates an existing movie using its MongoDB ID. Authentication is required.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ID of the movie."
          },
          {
            "name": "body",
            "in": "body",
            "description": "Updated movie information. All fields are required.",
            "required": true,
            "schema": {
              "$ref": "#/definitions/MovieInput"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Movie updated successfully."
          },
          "400": {
            "description": "Invalid movie data or ID."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Movie not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "delete": {
        "tags": [
          "Movies"
        ],
        "summary": "Delete a movie",
        "description": "Deletes an existing movie using its MongoDB ID. Authentication is required.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ID of the movie."
          }
        ],
        "responses": {
          "204": {
            "description": "Movie deleted successfully."
          },
          "400": {
            "description": "Invalid movie ID."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Movie not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
